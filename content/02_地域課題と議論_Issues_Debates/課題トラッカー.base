filters:
  and:
    - file.inFolder("02_地域課題と議論_Issues_Debates")
    - file.ext == "md"
formulas:
  days_since_updated: (now() - file.mtime).days
properties:
  status:
    displayName: ステータス
  formula.days_since_updated:
    displayName: 最終更新からの日数
views:
  - type: table
    name: 全課題一覧
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - file.mtime
      - formula.days_since_updated
